<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are disabled (allowBackup=false); these rules make the opt-out
     explicit on Android 12+, where allowBackup alone is deprecated. No
     app data, device config, or keystore material is ever backed up. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
