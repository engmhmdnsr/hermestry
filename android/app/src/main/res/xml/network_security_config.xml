<?xml version="1.0" encoding="utf-8"?>
<!-- Loopback-only cleartext: the on-device gateway binds 127.0.0.1:8080 over
     plain http, so the WebView must be allowed to talk to it. Everything
     else stays denied, so no remote host can receive cleartext traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
