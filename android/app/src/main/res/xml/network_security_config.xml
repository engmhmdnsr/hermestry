<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext allowlist: the on-device gateway binds 127.0.0.1:8080 over
     plain http. Everything else stays denied, so no other host can
     receive cleartext traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- On-device gateway only: it binds 127.0.0.1:8080 over plain http.
         The account service is reached over https, so no remote cleartext
         exception is needed (a tailnet IP was allowlisted here before and
         has been removed). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
