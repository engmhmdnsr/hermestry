<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Release hardening (SEC-01): android:debuggable is NOT set here on
         purpose. The merged manifest value comes from android/app/build.gradle
         (debug debuggable=true, release debuggable=false). Do not add
         android:debuggable to this file. scripts/release-check.sh rejects any
         release APK whose merged manifest has debuggable=true. -->
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <!-- adjustResize (INSET-01): the chat composer and any focused
                 input must not sit behind the IME.
                 API 35+ (edge-to-edge enforced, see res/values-v35/styles.xml):
                 the window is never resized by the IME, the system reports the
                 IME inset and Capacitor 8 SystemBars pads the decor view by it
                 (insetsHandling=css default, viewport-fit=cover in index.html).
                 API < 35 (legacy window): adjustResize shrinks the window, so
                 the IME inset reads 0 and SystemBars adds no second padding.
                 MainActivity does not touch softInputMode at runtime. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- No FileProvider: nothing in the app shares a file through a
             content:// URI (the install log is read in-app), and the old
             declaration granted the whole external storage tree. -->

        <service
            android:name=".service.MobileGatewayService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <!-- dataSync only: the gateway syncs chats, memory and files.
                 specialUse was dropped for Play review (it needs a strong
                 justification); dataSync needs none. -->
        </service>
        <!-- WorkManager internal FGS host: dataSync to match the BootWorker ForegroundInfo. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge">
        </service>
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Projects: the agent works on user files without any broad storage
         permission. The user picks a folder with the system picker and the
         app imports a copy into its own storage; export writes it back out.
         MANAGE_EXTERNAL_STORAGE was dropped: raw /storage paths are
         unreadable on Android 11+ anyway and Play rejects that permission
         for apps that are not file managers. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- R1: alert channel (approvals, job results) needs this on Android 13+.
         Requested at runtime after the first successful install; the FGS
         notification itself stays exempt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
